# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns are deliberately unanchored. This is a monorepo, so a leading slash would
# only match the repo root and miss api/node_modules, web/.next, api/dist, and so on.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# build output
.next/
out/
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values are never committed
.env*
# ...but the template must be, so setup stays reproducible
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling state, not project config
.claude/settings.local.json

# internal working notes — the deliverables are README.md and docs/adr/
PLAN.md
