# Copy to .env.local. Real values are never committed — .env* is gitignored.

# Server-side only — deliberately NOT NEXT_PUBLIC_-prefixed, so it never reaches the browser
# bundle. next.config.ts proxies /api/* here so the browser only ever talks to this app's own
# origin, which is what makes the session cookie first-party instead of third-party.
#
# Local dev:  http://localhost:4000
# Production: the Render service URL
API_URL="http://localhost:4000"
