# Copy to .env.local and fill in. Real values are never committed — .env* is gitignored.

NODE_ENV="development"
PORT="4000"

# MongoDB Atlas connection string, INCLUDING the database name before the query string.
#
# If `npm run bootstrap` fails with `querySrv ECONNREFUSED`, your local DNS resolver does not
# answer SRV queries. Use the standard (non-SRV) connection string from Atlas instead — it
# lists the shard hosts explicitly and skips the SRV lookup entirely.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/orders_and_settlements?retryWrites=true&w=majority"

# Origin allowed to call this API with credentials.
WEB_ORIGIN="http://localhost:3000"
